# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart
# Exception: vendored third-party plugins ship their pigeon output upstream.
# Ignoring it here left Android builds unable to compile from a clean checkout.
# Regenerate from the vendored package with its pinned Pigeon version. Ensure
# Xcode's `swift-format` and `clang-format` are available on PATH so Dart and
# native host outputs are produced as one reviewed change.
!packages/platform_player/third_party/**/lib/src/*.g.dart

