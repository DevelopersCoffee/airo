# Generated by scripts/check-build-profiles.py
build-profile-report.md
# Kotlin compiler daemon session files
**/.kotlin/

# Agent skills (installed globally / by plugins — not project source)
.claude/skills/
.claude/plugins/
.agents/skills/
.augment/skills/
skills-lock.json

# Exception: bundled skills that ship with the repo (installed via scripts/skills.sh)
!.claude/skills/android-tv-design/
!.claude/skills/android-tv-design/**

# IDE-generated workspace descriptors
*.iml

# Release artifacts staging directory
artifacts/release/

# Airo Mind model weights — 74 MB+, fetched by the Model Manager, never committed
rust/airo_mind_runtime/models/*.bin
rust/airo_mind_runtime/models/*.gguf
rust/airo_mind_llama/models/*.gguf

# `airo_mind_whisper`'s offline integration tests (tests/speech_offline.rs)
# look for a real GGML model here and skip gracefully when it is absent — a
# developer machine's local copy for running those tests, never source.
rust/airo_mind_whisper/models/*.bin

# Test-only GGUF/GGML weights the whisper/llama crates' own `#[test]`s and the
# airo_mind_cli dev-loop tool load from disk (see each crate's tests/ and
# airo_mind_cli/README.md for the exact download commands). 78 MB / 491 MB —
# never committed, same reasoning as airo_mind_runtime above.
rust/airo_mind_whisper/models/*.bin
rust/airo_mind_llama/models/*.gguf

# Generated by the size-gate and model-artifact workflows. They are uploaded as
# build artifacts and posted as PR comments; a copy left in the working tree
# after a local run is output, not source.
module-size-report.md
model-artifact-report.md

# Applied transiently by app/tool/run_mind_macos.sh and
# scripts/verify-mind-macos-e2e.sh from app/tool/mind_macos_pubspec_overrides.yaml,
# then removed by their own cleanup trap. A committed copy here fully replaces
# app/pubspec.yaml's dependency_overrides for every `pub get` (pub's rule, not
# ours) and silently breaks the full/phone and TV/Coins profiles.
app/pubspec_overrides.yaml
