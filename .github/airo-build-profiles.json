      ],
      "heavyPackages": [],
      "requiredDependencyOverrides": {
        "screen_protector": "../packages/platform_player/third_party/screen_protector"
      },
      "assetAllowlist": [],
      "android": {
        "apkArtifact": "app-arm64-v8a-release.apk",
        "abiStrategy": "single-arm64-apk",
        "releaseBudgetMb": 25,
        "debugBudgetMb": 200,
        "enforceReleaseBudget": true
